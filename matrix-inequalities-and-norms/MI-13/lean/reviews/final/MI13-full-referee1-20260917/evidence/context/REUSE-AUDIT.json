  "targeted_reuse": {
    "singular values": "Reuse actual LinearMap.singularValues and square/antitone/nonnegative/zero-extension API.",
    "all-rank SVD": "Reuse ordered Gram eigenvectorBasis and Orthonormal.exists_orthonormalBasis_extension_of_card_eq on positive indices; no unnecessary rank-counting proof.",
    "Rayleigh": "Reuse LinearMap.IsSymmetric.hasEigenvalue_iSup_of_finiteDimensional, prove positivity and energy semantic bridge.",
    "padding": "Reuse actual fromBlocks/reindex algebra; ordered singular-value preservation remains explicit new transport work.",
    "commutator": "Internal finite proof required; no external literature assumption.",
    "LeanCert": "Plan narrow PointIneq import and kernel mode; exact half certificate only, no computation run."
  },
  "limits": "Targeted pinned API reading, not a global proof of absence in every repository. Reference snapshots are inactive .txt files. No existing problem-specific theorem is imported."
