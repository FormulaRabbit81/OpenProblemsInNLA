instDiscreteTopologyBool
instTopologicalSpaceSubtype
instTopologicalSpaceQuot
'NLA.PF02.witness_data' depends on axioms: [propext, Classical.choice, Quot.sound]
NLA.PF02.witness_data :
  (∀ (i j : Fin 6), 0 < witnessM i j) ∧
    Matrix.det witnessM = 8192 ∧
      Matrix.rank witnessM = 6 ∧
        Matrix.det (rowCoordinates (witnessFactors 1)) = 32 ∧ Matrix.det (rowCoordinates (witnessFactors (-1))) = -32
'NLA.PF02.witness_factorizations' depends on axioms: [propext, Classical.choice, Quot.sound]
NLA.PF02.witness_factorizations :
  IsFactorization witnessM (witnessTuple 1) ∧
    IsFactorization witnessM (witnessTuple (-1)) ∧
      (∀ (i : Fin 6), Matrix.PosDef (witnessFactors 1 i)) ∧ ∀ (i : Fin 6), Matrix.PosDef (witnessFactors (-1) i)
'NLA.PF02.witness_minimal_rank' depends on axioms: [propext, Classical.choice, Quot.sound]
NLA.PF02.witness_minimal_rank : IsPSDRank witnessM 3
'NLA.PF02.orbit_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
NLA.PF02.orbit_semantics {p q k : ℕ} (M : Mat p q) :
  Topology.IsQuotientMap (Quot.mk Congruent) ∧
    ∀ (F G : Factorization M k), Quot.mk Congruent F = Quot.mk Congruent G ↔ Congruent F G
'NLA.PF02.orientation_nonvanishing' depends on axioms: [propext, Classical.choice, Quot.sound]
NLA.PF02.orientation_nonvanishing (F : Factorization witnessM 3) : orientationDet F ≠ 0
'NLA.PF02.orientation_preserved' depends on axioms: [propext, Classical.choice, Quot.sound]
NLA.PF02.orientation_preserved (F G : Factorization witnessM 3) :
  Congruent F G → (0 < orientationDet F ↔ 0 < orientationDet G)
'NLA.PF02.quotient_separation' depends on axioms: [propext, Classical.choice, Quot.sound]
NLA.PF02.quotient_separation : ∃ f, Continuous f ∧ Function.Surjective f
'NLA.PF02.witness_disconnected' depends on axioms: [propext, Classical.choice, Quot.sound]
NLA.PF02.witness_disconnected : ¬IsConnected Set.univ
'NLA.PF02.canonical_counterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
