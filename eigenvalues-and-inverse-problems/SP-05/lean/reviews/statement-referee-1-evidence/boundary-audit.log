@[reducible] def NLA.SP05.columnVec : {n : ℕ} → Mat n → Vec n :=
fun {n} X => Matrix.vec X
def NLA.SP05.commutationMatrix : (n : ℕ) → Operator n :=
fun n i j => if i = j.swap then 1 else 0
def NLA.SP05.frobeniusSq : {n : ℕ} → Mat n → ℝ :=
fun {n} X => ∑ i, ∑ j, X i j ^ 2
def NLA.SP05.rayleigh : {n : ℕ} → Operator n → Vec n → ℝ :=
fun {n} K v => v ⬝ᵥ K *ᵥ v / v ⬝ᵥ v
def NLA.SP05.jordanMatrix : {n : ℕ} → Mat n → Mat n → Operator n :=
fun {n} A B => Matrix.kronecker A B + Matrix.kronecker B A
def NLA.SP05.sectorValues : {n : ℕ} → Mat n → Mat n → ℝ → Set ℝ :=
fun {n} A B ε => {r | ∃ v, v ≠ 0 ∧ commutationMatrix n *ᵥ v = ε • v ∧ r = rayleigh (Matrix.kronecker A B) v}
def NLA.SP05.skewExample : (n : ℕ) → Mat n :=
fun n i j => if ↑i = 0 ∧ ↑j = 1 then 1 else if ↑i = 1 ∧ ↑j = 0 then -1 else 0
def Matrix.PosDef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} → [inst : Ring R] → [PartialOrder R] → [StarRing R] → Matrix n n R → Prop :=
fun {n} {R} [Ring R] [PartialOrder R] [StarRing R] M =>
  M.IsHermitian ∧ ∀ ⦃x : n →₀ R⦄, x ≠ 0 → 0 < x.sum fun i xi => x.sum fun j xj => star xi * M i j * xj
def Matrix.PosSemidef.{u_2, u_3} : {n : Type u_2} →
  {R : Type u_3} → [inst : Ring R] → [PartialOrder R] → [StarRing R] → Matrix n n R → Prop :=
fun {n} {R} [Ring R] [PartialOrder R] [StarRing R] M =>
  M.IsHermitian ∧ ∀ (x : n →₀ R), 0 ≤ x.sum fun i xi => x.sum fun j xj => star xi * M i j * xj
def IsLeast.{u_1} : {α : Type u_1} → [LE α] → Set α → α → Prop :=
fun {α} [LE α] s a => a ∈ s ∧ a ∈ lowerBounds s
NLA.SP05.numerical_bound : 0 < 2
NLA.SP05.column_vectorization {n : ℕ} (A B X : Mat n) :
  Matrix.kronecker A B *ᵥ columnVec X = columnVec (B * X * Aᵀ) ∧
    commutationMatrix n *ᵥ columnVec X = columnVec Xᵀ ∧ columnVec X ⬝ᵥ columnVec X = frobeniusSq X
NLA.SP05.skew_witness (n : ℕ) (hn : 2 ≤ n) :
  (skewExample n)ᵀ = -skewExample n ∧ frobeniusSq (skewExample n) = 2 ∧ skewExample n ≠ 0
NLA.SP05.positive_minimizer (n : ℕ) (hn : 1 ≤ n) (A B : Mat n) (hA : Matrix.PosDef A) (hB : Matrix.PosDef B) :
  ∃ μ X,
    0 < μ ∧
      Matrix.PosSemidef X ∧
        X ≠ 0 ∧
          jordanMatrix A B *ᵥ columnVec X = μ • columnVec X ∧ ∀ (v : Vec n), v ≠ 0 → μ ≤ rayleigh (jordanMatrix A B) v
NLA.SP05.sector_minima (n : ℕ) (hn : 2 ≤ n) (A B : Mat n) (hA : Matrix.PosDef A) (hB : Matrix.PosDef B) :
  ∃ a b, IsLeast (sectorValues A B 1) a ∧ IsLeast (sectorValues A B (-1)) b
NLA.SP05.canonical_result (n : ℕ) (hn : 2 ≤ n) (A B : Mat n) (hA : Matrix.PosDef A) (hB : Matrix.PosDef B) :
  ∃ a b, IsLeast (sectorValues A B 1) a ∧ IsLeast (sectorValues A B (-1)) b ∧ a ≤ b
