Matrix.kronecker_mulVec_vec.{u_1, u_2, u_3, u_4, u_5} {l : Type u_1} {m : Type u_2} {n : Type u_4} {p : Type u_5}
  {R : Type u_3} [NonUnitalCommSemiring R] [Fintype m] [Fintype n] (A : Matrix l m R) (X : Matrix m n R)
  (B : Matrix p n R) : (Matrix.kroneckerMap (fun x1 x2 => x1 * x2) B A).mulVec X.vec = (A * X * B.transpose).vec
Matrix.vec_dotProduct_vec.{u_1, u_2, u_3} {m : Type u_2} {n : Type u_3} {R : Type u_1} [AddCommMonoid R] [Mul R]
  [Fintype m] [Fintype n] (A B : Matrix m n R) : A.vec ⬝ᵥ B.vec = (A.transpose * B).trace
Matrix.star_vec_dotProduct_vec.{u_1, u_2, u_3} {m : Type u_2} {n : Type u_3} {R : Type u_1} [AddCommMonoid R] [Mul R]
  [Star R] [Fintype m] [Fintype n] (A B : Matrix m n R) : star A.vec ⬝ᵥ B.vec = (A.conjTranspose * B).trace
